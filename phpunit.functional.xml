<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap=".build/vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation=".build/vendor/phpunit/phpunit/phpunit.xsd"
    backupGlobals="true"
    colors="true"
    convertErrorsToExceptions="true"
    convertWarningsToExceptions="true"
    forceCoversAnnotation="false"
    processIsolation="false"
    stopOnError="false"
    stopOnFailure="false"
    stopOnIncomplete="false"
    stopOnSkipped="false"
    verbose="false"
    beStrictAboutTestsThatDoNotTestAnything="false"
    failOnWarning="true"
    failOnRisky="true"
>
    <testsuites>
        <testsuite name="EXT:t3hauler functional tests">
            <directory>Tests/Functional/</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- Suppress E_USER_DEPRECATED until all vendor packages are compatible -->
        <ini name="error_reporting" value="E_ALL &amp; ~E_USER_DEPRECATED" />
        <env name="TYPO3_CONTEXT" value="Testing" />
        <!-- Configure SQLite for functional tests -->
        <env name="typo3DatabaseDriver" value="pdo_sqlite" />
        <!-- Configure test instance path -->
        <env name="TYPO3_PATH_ROOT" value=".build/Web" />
        <env name="TYPO3_PATH_APP" value=".build/Web" />
        <!-- Enable database schema for tests -->
        <env name="typo3DatabaseSchemaUpdate" value="1" />
        <!-- Configure additional extensions -->
        <env name="TYPO3_INSTALL_DB_DRIVER" value="sqlite" />
    </php>

    <coverage includeUncoveredFiles="true">
        <include>
            <directory suffix=".php">Classes</directory>
        </include>
        <exclude>
            <directory>Classes/Command</directory>
            <file>Classes/Configuration/ExtensionConfiguration.php</file>
        </exclude>
        <report>
            <html outputDirectory=".build/log/coverage-functional" lowUpperBound="50" highLowerBound="80"/>
            <clover outputFile=".build/log/coverage-functional/clover.xml"/>
        </report>
    </coverage>

    <logging>
        <junit outputFile=".build/log/functional-junit.xml"/>
    </logging>
</phpunit>
